{
  "name": "cdda-voxel-studio",
  "version": "0.1.0",
  "private": true,
  "repository": "github:WangYuLei5433/cdda-voxel-studio",
  "type": "module",
  "description": "Browse every Cataclysm: Dark Days Ahead object and preview its voxel model (cataclysm-3d voxel sets).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run tests/unit",
    "test:browser": "playwright test",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "starter": "node tools/fetch-voxel-starter.mjs",
    "classify": "node tools/classify/builtin-kinds.mjs",
    "catalog": "node tools/editor/catalog.mjs"
  },
  "dependencies": {
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.177.0",
    "eslint": "^9.27.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
